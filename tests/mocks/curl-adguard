#!/bin/bash
# Fake curl standing in for AdGuard Home's web API (lib/adguard.sh tests),
# following AdGuard Home's own handlers: a login is only checked when users
# exist, a bad or missing one gets 401 with an empty body, and POST/PUT
# with a body but no "Content-Type: application/json" gets 415.
# Installed as curl by use_adguard (tests/lib/harness.sh). State, /tmp/agh:
#   auth       "user:password": a login is required (absent: no users)
#   version    version reported by /control/status (default v0.107.79)
#   running    "false": the DNS server is not running
#   curl-rc    exit with this status instead (timeout, connection refused);
#              curl-rc.<endpoint> for one endpoint
#   status     answer every request with this HTTP status ...
#   body       ... and this body (alone: status 200)
#   status.<endpoint>, body.<endpoint>   the same for one endpoint ("/"
#              written "_", e.g. status.rewrite_list)
#   rewrites   body of GET rewrite/list (default [])
#   add-store  JSON list POST rewrite/add appends instead of the posted
#              record ("[]": accepted, nothing stored)
#   after-add/ state files moved into /tmp/agh once a POST rewrite/add
#              succeeds (e.g. a list read that fails only afterwards)
#   rewrite-settings  body of GET rewrite/settings (default
#              {"enabled":true}); versions before v0.107.68 answer 404
# Every call is logged: its arguments to /tmp/mock-calls.log ("curl ..."),
# "<METHOD> <endpoint> auth=<none|ok|bad>" to /tmp/agh/requests.log, and
# for a request with a body "<endpoint><TAB><content-type><TAB><body>" to
# /tmp/agh/bodies.log. POST rewrite/add does what AdGuard Home does: 400
# for a body it cannot decode, else the record is appended to rewrites
# with the domain lowercased and the answer as sent, and 200 with no body.
# The -K config read from stdin (where the login is) is never stored.
S=/tmp/agh
echo "curl $*" >> /tmp/mock-calls.log
mkdir -p "$S"

config="" method=GET out="" fmt="" url="" ctype="" has_body=0 data=""
while (($#)); do
    case "$1" in
        -K|--config) [[ "$2" == - ]] && config=$(cat); shift ;;
        -o) out="$2"; shift ;;
        -w) fmt="$2"; shift ;;
        -X) method="$2"; shift ;;
        -H) [[ "${2,,}" == content-type:* ]] && ctype="${2#*: }"; shift ;;
        --data-binary) has_body=1 data="$2"; shift ;;
        --proto|--connect-timeout|--max-time|--max-filesize) shift ;;
        http://*|https://*) url="$1" ;;
    esac
    shift
done

auth=none
if [[ "$config" =~ Authorization:\ Basic\ ([A-Za-z0-9+/=]+) ]]; then
    auth=bad
    [[ -f "$S/auth" && "$(printf '%s' "${BASH_REMATCH[1]}" | base64 -d)" == "$(cat "$S/auth")" ]] && auth=ok
fi
path="${url#*://}"
path="/${path#*/}"
endpoint=""
[[ "$path" == */control/* ]] && endpoint="${path#*/control/}"
echo "$method ${endpoint:-$path} auth=$auth" >> "$S/requests.log"
((has_body)) && printf '%s\t%s\t%s\n' "${endpoint:-$path}" "$ctype" "$data" >> "$S/bodies.log"

for f in "" ".${endpoint//\//_}"; do
    [[ -f "$S/curl-rc$f" ]] && exit "$(cat "$S/curl-rc$f")"
done

reply() { # status body
    [[ -n "$out" ]] && printf '%s' "$2" > "$out"
    [[ "$fmt" == *http_code* ]] && printf '%s' "$1"
    exit 0
}

for f in "" ".${endpoint//\//_}"; do
    if [[ -f "$S/status$f" || -f "$S/body$f" ]]; then
        reply "$(cat "$S/status$f" 2>/dev/null || echo 200)" "$(cat "$S/body$f" 2>/dev/null)"
    fi
done
[[ -f "$S/auth" && "$auth" != ok ]] && reply 401 ""
version=$(cat "$S/version" 2>/dev/null || echo v0.107.79)
if [[ "$method" == POST || "$method" == PUT ]] && ((has_body)) && [[ "$ctype" != application/json ]]; then
    reply 415 "only application/json is allowed"
fi

case "$method $endpoint" in
    "GET status")
        reply 200 "$(jq -nc --arg v "$version" \
            --argjson r "$(cat "$S/running" 2>/dev/null || echo true)" \
            '{version:$v, running:$r, protection_enabled:true, dns_addresses:["127.0.0.1"],
              dns_port:53, http_port:80, language:"en", protection_disabled_duration:0}')"
        ;;
    "GET rewrite/list") reply 200 "$(cat "$S/rewrites" 2>/dev/null || echo '[]')" ;;
    "GET rewrite/settings")
        if [[ "$(printf '%s\n' v0.107.68 "$version" | sort -V | head -1)" == v0.107.68 ]]; then
            reply 200 "$(cat "$S/rewrite-settings" 2>/dev/null || echo '{"enabled":true}')"
        fi
        ;;
    "POST rewrite/add")
        jq -e 'type == "object" and (.domain | type) == "string" and (.answer | type) == "string"' \
            <<< "$data" >/dev/null 2>&1 || reply 400 "json.Decode: invalid rewrite entry"
        # "enabled" is only reported from v0.107.68 on.
        new=$(jq -c --arg v "$version" '[{domain: (.domain | ascii_downcase), answer, enabled: true}
            | if ($v | ltrimstr("v") | split(".") | map(tonumber)) < [0, 107, 68] then del(.enabled) else . end]' <<< "$data")
        [[ -f "$S/add-store" ]] && new=$(cat "$S/add-store")
        jq -c --argjson new "$new" '(. // []) + $new' <<< "$(cat "$S/rewrites" 2>/dev/null || echo '[]')" > "$S/rewrites.new" \
            && mv "$S/rewrites.new" "$S/rewrites"
        if [[ -d "$S/after-add" ]]; then
            cp -r "$S/after-add/." "$S/" && rm -rf "$S/after-add"
        fi
        reply 200 ""
        ;;
    *" status"|*" rewrite/list"|*" rewrite/settings") reply 405 "only method GET is allowed" ;;
    *" rewrite/add") reply 405 "only method POST is allowed" ;;
esac
reply 404 "404 page not found"
